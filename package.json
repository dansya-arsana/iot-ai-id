{
  "name": "iot-ai-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx services/api/server.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsx scripts/build-seo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm test && npm run build",
    "test:e2e": "playwright test",
    "coordinator": "tsx services/coordinator/server.ts",
    "node:connect": "tsx runtime/local-bridge/node-client.ts",
    "coordinator:mcp": "tsx services/coordinator/mcp.ts",
    "api:mcp": "tsx services/api/mcp.ts",
    "agent:run": "tsx scripts/agent-runner.ts",
    "desktop:package": "npm run build && tsx scripts/package-desktop.ts",
    "check:tokens": "tsx scripts/check-design-tokens.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "@wokwi/elements": "1.9.2",
    "@xyflow/react": "^12.12.0",
    "arduino-mcp-server": "0.2.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
