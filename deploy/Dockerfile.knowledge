FROM python:3.10-slim-bookworm
RUN pip install --no-cache-dir --only-binary=:all: 'llama-cpp-python==0.3.36' --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu
RUN pip install --no-cache-dir 'openviking[local-embed]==0.4.23'
WORKDIR /data
COPY deploy/knowledge.json /conf/knowledge.json
CMD ["python", "-m", "openviking.server.bootstrap", "--config", "/conf/knowledge.json", "--host", "0.0.0.0", "--port", "1933"]
