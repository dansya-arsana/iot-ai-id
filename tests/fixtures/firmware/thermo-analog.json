{"toolchain":"arduino-cli 1.5.1 · arduino:avr 1.8.8 · avr-gcc 7.3.0 · -fno-lto","variant":{"id":"raw","sketch":"thermo-analog","source":"// Test fixture: an LM35 on A0 (10 mV per degC) and a 10k B3950 NTC divider on A1 (beta equation), both read with analogRead.\nconst float BETA = 3950.0, R0 = 10000.0, T0 = 298.15, RSERIES = 10000.0;\nuint16_t readEvery = 100;\nvoid setup() {\n  Serial.begin(9600);\n  Serial.println(\"ready\");\n}\nvoid loop() {\n  int a0 = analogRead(A0);\n  float lm35 = a0 * 5000.0 / 1023.0 / 10.0;\n  int a1 = analogRead(A1);\n  float rntc = RSERIES * (1023.0 / a1 - 1.0);       // NTC on the supply side, series resistor to GND\n  float tk = 1.0 / (1.0 / T0 + log(rntc / R0) / BETA);\n  Serial.print(\"lm35=\"); Serial.print(lm35, 1);\n  Serial.print(\" a1=\"); Serial.print(a1);\n  Serial.print(\" ntc=\"); Serial.println(tk - 273.15, 1);\n  delay(readEvery);\n}\n","template":"// Test fixture: an LM35 on A0 (10 mV per degC) and a 10k B3950 NTC divider on A1 (beta equation), both read with analogRead.\nconst float BETA = 3950.0, R0 = 10000.0, T0 = 298.15, RSERIES = 10000.0;\nuint16_t readEvery = 100;\nvoid setup() {\n  Serial.begin(9600);\n  Serial.println(\"ready\");\n}\nvoid loop() {\n  int a0 = analogRead(A0);\n  float lm35 = a0 * 5000.0 / 1023.0 / 10.0;\n  int a1 = analogRead(A1);\n  float rntc = RSERIES * (1023.0 / a1 - 1.0);       // NTC on the supply side, series resistor to GND\n  float tk = 1.0 / (1.0 / T0 + log(rntc / R0) / BETA);\n  Serial.print(\"lm35=\"); Serial.print(lm35, 1);\n  Serial.print(\" a1=\"); Serial.print(a1);\n  Serial.print(\" ntc=\"); Serial.println(tk - 273.15, 1);\n  delay(readEvery);\n}\n","flashBase64":"","bytes":4694,"sha256":"4d245f673d3a3a70c8ada38de5ed2f815f066cbd0a9b8ffbd162e16630cbe67d","lines":[[149,154,6],[155,162,8],[163,166,9],[167,170,11],[171,196,12],[197,206,13],[207,212,14],[213,238,10],[239,244,14],[245,257,15],[258,263,16],[264,285,13],[286,299,16],[300,305,17],[306,313,18],[314,315,17]],"params":[]}}