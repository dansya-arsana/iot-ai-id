{"toolchain":"arduino-cli 1.5.1 · arduino:avr 1.8.8 · avr-gcc 7.3.0 · -fno-lto","variant":{"id":"raw","sketch":"spi-id","source":"// Test fixture: SPI master at register level (no library). Reads register 0x0F of the slave on CS = D10 and prints it.\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(10, OUTPUT);\n  digitalWrite(10, HIGH);\n  pinMode(11, OUTPUT);  // MOSI\n  pinMode(13, OUTPUT);  // SCK\n  SPCR = (1 << SPE) | (1 << MSTR) | (1 << SPR0);  // master, mode 0, f/16\n  Serial.println(\"ready\");\n}\n\nuint8_t xfer(uint8_t b) {\n  SPDR = b;\n  while (!(SPSR & (1 << SPIF))) {}\n  return SPDR;\n}\n\nvoid loop() {\n  digitalWrite(10, LOW);\n  xfer(0x8F);              // read register 0x0F\n  uint8_t id = xfer(0x00);\n  uint8_t next = xfer(0x00);\n  digitalWrite(10, HIGH);\n  Serial.print(\"id=\");\n  Serial.print(id, HEX);\n  Serial.print(\" next=\");\n  Serial.println(next, HEX);\n  delay(100);\n}\n","template":"// Test fixture: SPI master at register level (no library). Reads register 0x0F of the slave on CS = D10 and prints it.\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(10, OUTPUT);\n  digitalWrite(10, HIGH);\n  pinMode(11, OUTPUT);  // MOSI\n  pinMode(13, OUTPUT);  // SCK\n  SPCR = (1 << SPE) | (1 << MSTR) | (1 << SPR0);  // master, mode 0, f/16\n  Serial.println(\"ready\");\n}\n\nuint8_t xfer(uint8_t b) {\n  SPDR = b;\n  while (!(SPSR & (1 << SPIF))) {}\n  return SPDR;\n}\n\nvoid loop() {\n  digitalWrite(10, LOW);\n  xfer(0x8F);              // read register 0x0F\n  uint8_t id = xfer(0x00);\n  uint8_t next = xfer(0x00);\n  digitalWrite(10, HIGH);\n  Serial.print(\"id=\");\n  Serial.print(id, HEX);\n  Serial.print(\" next=\");\n  Serial.println(next, HEX);\n  delay(100);\n}\n","flashBase64":"","bytes":2698,"sha256":"aa41aa1c743d53a4d883ae28f7e06a88e1bc61c28cece62f7c2384a7f5e41e1d","lines":[[144,147,4],[148,151,5],[152,155,6],[156,159,7],[160,161,8],[162,167,9],[168,168,13],[169,171,14],[172,172,15],[173,173,16],[174,175,18],[176,179,19],[180,182,20],