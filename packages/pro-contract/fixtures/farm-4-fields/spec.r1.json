     "gpio": 26,
     "func": "irq",
     "part": "lora-rfm95w-1",
     "partPin": "DIO0",
     "symbol": "PIN_LORA_DIO0"
    }
   ],
   "wires": [
    {
     "id": "W1",
     "from": {
      "part": "soil-moisture-capacitive-1",
      "pin": "AOUT"
     },
     "to": {
      "part": "board",
      "pin": "GPIO34"
     },
     "func": "signal",
     "color": "yellow",
     "label": "W1 · GPIO34 → AOUT (soil)",
     "lengthM": 3,
     "awg": 22,
     "cable": "3-core-shielded",
     "connectors": {
      "from": "screw-terminal",
      "to": "header"
     },
     "viaGland": true
    },
    {
     "id": "W2",
     "from": {
