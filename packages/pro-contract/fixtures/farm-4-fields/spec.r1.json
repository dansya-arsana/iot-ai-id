    }
   ],
   "pins": [
    {
     "boardPin": "GPIO34",
     "gpio": 34,
     "func": "adc",
     "part": "soil-moisture-capacitive-1",
     "partPin": "AOUT",
     "symbol": "PIN_SOIL_1"
    },
    {
     "boardPin": "GPIO4",
     "gpio": 4,
     "func": "onewire",
     "part": "ds18b20-1",
     "partPin": "DQ",
     "symbol": "PIN_DS18B20"
    },
    {
     "boardPin": "GPIO5",
     "gpio": 5,
     "func": "spi-cs",
     "part": "lora-rfm95w-1",
     "partPin": "NSS",
