 "untrusted": {
  "summary": {
   "v": {
    "en": "Corrosion-free capacitive soil moisture probe v2.0 with a PH2.0 3-pin cable. Output falls as soil gets wetter (about 2.5 V dry, 1.3 V wet on a 5 V supply). Calibrate dry and wet readings per probe and per soil.",
    "id": "Probe kelembapan tanah kapasitif v2.0 tanpa korosi dengan kabel PH2.0 3 pin. Keluaran turun saat tanah makin basah (sekitar 2,5 V kering, 1,3 V basah pada catu 5 V). Kalibrasi nilai kering dan basah untuk tiap probe dan tanah."
   },
   "p": {
    "source": "https://wiki.dfrobot.com/Capacitive_Soil_Moisture_Sensor_SKU_SEN0193 ; https://makerselectronics.com/product/capacitive-soil-moisture-sensor-v2-0",
    "verifiedBy": "import",
    "at": "2026-10-23",
    "confidence": "medium"
   }
  },
  "pitfalls": [
   {
    "v": {
     "en": "NE555 clones do not oscillate reliably below about 4.5 V: on 3.3 V the output sticks near the dry value. Use a TLC555 board or a 5 V supply.",
     "id": "Klon NE555 tidak berosilasi andal di bawah sekitar 4,5 V: pada 3,3 V keluaran macet di dekat nilai kering. Pakai papan TLC555 atau catu 5 V."
    },
    "p": {
     "source": "docs/research/pro-parts-briefs.md",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "low"
    }
   },
   {
    "v": {
     "en": "Insert only up to the white line and seal the top edge with lacquer, or water creeps into the electronics.",
     "id": "Tancapkan hanya sampai garis putih dan segel tepi atas dengan pernis, kalau tidak air merembes ke elektronik."
    },
