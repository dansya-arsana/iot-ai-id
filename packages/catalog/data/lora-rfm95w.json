  "summary": {
   "v": {
    "en": "A 868/915 MHz LoRa radio on a 16 x 16 mm castellated module (Semtech SX1276). Used at 920-923 MHz it sits inside the Indonesian AS923-2 plan. The default radio for Pro field nodes.",
    "id": "Radio LoRa 868/915 MHz pada modul castellated 16 x 16 mm (Semtech SX1276). Dipakai di 920-923 MHz, masuk rencana AS923-2 Indonesia. Radio bawaan untuk node lapangan Pro."
   },
   "p": {
    "source": "https://resources.lora-alliance.org/technical-specifications/rp002-1-0-4-regional-parameters",
    "verifiedBy": "import",
    "at": "2026-10-23",
    "confidence": "medium"
   }
  },
  "pitfalls": [
   {
    "v": {
     "en": "3.3 V only. 5 V on VCC or on a logic pin destroys the module: use a 3.3 V board or a level shifter.",
     "id": "Hanya 3,3 V. 5 V di VCC atau pin logika merusak modul: pakai papan 3,3 V atau level shifter."
    },
    "p": {
     "source": "https://www.semtech.com/products/wireless-rf/lora-connect/sx1276",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "high"
    }
   },
   {
    "v": {
     "en": "Never transmit without an antenna attached to ANT: the power amplifier can be damaged.",
     "id": "Jangan pernah memancar tanpa antena di ANT: penguat daya bisa rusak."
    },
    "p": {
     "source": "https://www.hoperf.com/modules/lora/RFM95.html",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "medium"
    }
   },
   {
