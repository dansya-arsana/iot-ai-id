  {
   "v": {
    "boardFamily": "esp32",
    "lib": "RadioLib (MIT)",
    "snippet": "#include <RadioLib.h>\n// SX1276 on the RFM95W: NSS, DIO0, NRST, DIO1 (pins are examples, set them to your wiring)\nSX1276 radio = new Module(5, 26, 14, 33);\nvoid setup() {\n  Serial.begin(115200);\n  int st = radio.begin(920.2);   // MHz, AS923-2 channel; the chip wakes at 434 MHz\n  if (st != RADIOLIB_ERR_NONE) { Serial.println(st); while (true); }\n  radio.setSpreadingFactor(7);\n  radio.setBandwidth(125.0);\n}\nvoid loop() {\n  radio.transmit(\"hello\");       // blocks until TxDone\n  delay(10000);\n}\n",
