  "summary": {
   "v": {
    "en": "A 433 MHz LoRa radio (Semtech SX1278) on a 17 x 16 mm stamp module. Kept for the Learn lab only. 433 MHz is not the Indonesian LoRa band (AS923-2, 920-923 MHz): in Pro it is a band error. Use lora-rfm95w.",
    "id": "Radio LoRa 433 MHz (Semtech SX1278) pada modul stamp 17 x 16 mm. Dipertahankan hanya untuk Lab Belajar. 433 MHz bukan pita LoRa Indonesia (AS923-2, 920-923 MHz): di Pro ini galat pita. Pakai lora-rfm95w."
   },
   "p": {
    "source": "docs/research/pro-parts-briefs.md",
    "verifiedBy": "import",
    "at": "2026-10-23",
    "confidence": "high"
   }
  },
  "pitfalls": [
   {
    "v": {
     "en": "Learn only. In Pro this part is a band error: the radio tunes 410-525 MHz and cannot reach 920-923 MHz. Choose lora-rfm95w.",
     "id": "Hanya untuk belajar. Di Pro part ini galat pita: radio menala 410-525 MHz dan tidak bisa mencapai 920-923 MHz. Pilih lora-rfm95w."
    },
    "p": {
     "source": "https://resources.lora-alliance.org/technical-specifications/rp002-1-0-4-regional-parameters",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "high"
    }
   },
   {
    "v": {
     "en": "3.3 V only, not 5 V tolerant. A Uno needs a level shifter and a 3.3 V supply.",
     "id": "Hanya 3,3 V, tidak tahan 5 V. Uno butuh level shifter dan catu 3,3 V."
    },
    "p": {
     "source": "https://aithinker-static.oss-cn-shenzhen.aliyuncs.com/docs/Public%20Document%20Center/LoRa/lora/Specification/Ra-02_V1.1%20Specification-20171219.pdf",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "medium"
    }
   },
   {
