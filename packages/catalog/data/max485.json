 "untrusted": {
  "summary": {
   "v": {
    "en": "Half-duplex 5 V TTL to RS-485 converter module for Modbus and long cables. DE high transmits, RE low receives; usually bridged. Has a 120 ohm terminator across A/B (some 100 ohm): keep it only at the two ends of the bus.",
    "id": "Modul konverter TTL 5 V ke RS-485 half-duplex untuk Modbus dan kabel panjang. DE high mengirim, RE low menerima; biasanya dijumper. Ada terminator 120 ohm di A/B (sebagian 100 ohm): pasang hanya di dua ujung bus."
   },
   "p": {
    "source": "https://www.analog.com/media/en/technical-documentation/data-sheets/MAX1487-MAX491.pdf ; https://protosupplies.com/product/max485-ttl-to-rs-485-interface-module/",
    "verifiedBy": "import",
    "at": "2026-10-23",
    "confidence": "medium"
   }
  },
  "pitfalls": [
   {
    "v": {
     "en": "RO swings to 5 V: with an ESP32 or Raspberry Pi that is a 5 V input on a 3.3 V pin. Add a divider or use a MAX3485 module.",
     "id": "RO naik sampai 5 V: pada ESP32 atau Raspberry Pi itu masukan 5 V ke pin 3,3 V. Tambahkan pembagi tegangan atau pakai modul MAX3485."
    },
    "p": {
     "source": "https://www.analog.com/media/en/technical-documentation/data-sheets/MAX1487-MAX491.pdf",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "high"
    }
   },
   {
    "v": {
     "en": "Never leave DE high when you want to listen: the driver blocks the bus. Switch back to receive right after the last byte.",
     "id": "Jangan biarkan DE high saat ingin mendengar: pengirim menahan bus. Kembali ke mode terima segera setelah byte terakhir."
    },
    "p": {
     "source": "https://www.analog.com/media/en/technical-documentation/data-sheets/MAX1487-MAX491.pdf",
     "verifiedBy": "import",
     "at": "2026-10-23",
     "confidence": "medium"
    }
   },
   {
