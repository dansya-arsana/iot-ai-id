    }
   },
   {
    "v": {
     "en": "Chip select is GPIO25 (pin 22), a manual pin, not CE0: software must drive it.",
     "id": "Chip select adalah GPIO25 (pin 22), pin manual, bukan CE0: perangkat lunak harus mengendalikannya."
