  "pitfalls": [
   {
    "v": {
     "en": "Single channel and one spreading factor: fine for point-to-point LoRa between our nodes, not a full LoRaWAN gateway.",
     "id": "Satu kanal dan satu spreading factor: cukup untuk LoRa titik-ke-titik antar node kita, bukan gateway LoRaWAN penuh."
    },
