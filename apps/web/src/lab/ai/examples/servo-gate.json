      "w-sig",
      "w-sv5",
      "w-sgnd"
     ]
    }
   }
  ],
  "goal": {
   "en": "Open a gate for 3 seconds when a button is pressed.",
   "id": "Buka palang gerbang selama 3 detik saat tombol ditekan."
