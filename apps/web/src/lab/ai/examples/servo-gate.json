  "sketch": {
   "source": "// Servo gate: press the button and the gate opens for 3 seconds.\n#include <Servo.h>\n\nconst int BUTTON = 2;\nconst int SERVO_PIN = 9;\nconst int CLOSED_DEG = 0;\nconst int OPEN_DEG = 90;\nconst unsigned long OPEN_MS = 3000;\n\nServo gate;\n\nvoid setup() {\n  pinMode(BUTTON, INPUT);          // pressed reads HIGH (pull-down resistor keeps it LOW)\n  gate.attach(SERVO_PIN);\n  gate.write(CLOSED_DEG);\n}\n\nvoid loop() {\n  if (digitalRead(BUTTON) == HIGH) {\n    gate.write(OPEN_DEG);\n    delay(OPEN_MS);\n    gate.write(CLOSED_DEG);\n    delay(400);\n  }\n}\n"
  },
  "steps": [
   {
    "caption": {
     "en": "A push button goes on the breadboard, with a 10k resistor that keeps the pin low until you press.",
     "id": "Tombol tekan dipasang di breadboard, dengan resistor 10k yang menjaga pin tetap rendah sampai ditekan."
    },
    "add": {
     "parts": [
      "btn1",
      "r1"
     ]
    }
   },
   {
    "caption": {
     "en": "5V to the button, pin 2 listens, the resistor returns to ground. Pressing makes pin 2 high.",
     "id": "5V ke tombol, pin 2 mendengarkan, resistor kembali ke ground. Saat ditekan, pin 2 menjadi tinggi."
    },
    "add": {
     "wires": [
